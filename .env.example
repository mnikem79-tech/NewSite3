# Образец настроек. На сервере файл называется .env и в репозиторий не попадает.
DJANGO_ENV=prod
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_ALLOWED_HOSTS=sandbox.nail-app.ru
CSRF_TRUSTED_ORIGINS=https://sandbox.nail-app.ru

# Пустое значение — сайт живёт в корне адреса. /newsite3 — в подкаталоге.
DJANGO_SCRIPT_NAME=

# Картинки из админки отдаёт Django (Caddy в контейнере их не видит).
SERVE_MEDIA=True

DATABASE_URL=postgres://newsite3:пароль@127.0.0.1:5432/newsite3_db

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@sandbox.nail-app.ru
