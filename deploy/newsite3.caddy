# NewSite3 — магазин в подкаталоге __PREFIX__ действующего домена.
#
# ЭТО НЕ ОТДЕЛЬНЫЙ ФАЙЛ КОНФИГУРАЦИИ, А ФРАГМЕНТ ДЛЯ ВСТАВКИ.
#
# Caddy на этом хосте работает в контейнере, внутрь которого примонтирован
# только сам Caddyfile. Поэтому ни «import другого файла», ни отдача
# каталогов с диска (file_server) изнутри контейнера невозможны: этих
# путей там попросту нет. Единственный источник истины — сам Caddyfile,
# правится дописыванием строк в блок домена.
#
# Вставить ВНУТРЬ существующего блока домена, перед root/file_server:
#
#     __DOMAIN__ {
#         import app_origin_tls
#         import security_headers
#
#         ... вставить сюда ...
#
#         root * /srv/www
#         file_server
#     }
#
# handle_path срабатывает раньше file_server основного сайта и
# перехватывает только __PREFIX__. Всё остальное идёт как раньше.

# --- NewSite3: магазин в подкаталоге __PREFIX__ ---
# Без завершающего слэша запрос ушёл бы в file_server основного сайта и дал 404.
redir __PREFIX__ __PREFIX__/ 308

handle_path __PREFIX__/* {
	reverse_proxy 127.0.0.1:__PORT__
}
# --- конец NewSite3 ---

# Статику (__PREFIX__/static/...) отдаёт whitenoise внутри самого Django:
# файлы уже собраны в staticfiles/ с хешами в именах и кэшируются навечно.
# Загруженные через админку картинки (__PREFIX__/media/...) отдаёт Django
# при SERVE_MEDIA=True — в отличие от whitenoise он видит новые файлы сразу,
# без перезапуска службы.
