#!/usr/bin/env bash
# NewSite3: блокировка случайного коммита секретов.
#
# История правок — чтобы не повторять ошибки:
#   1. Набор символов значения не включал кавычку, поэтому присвоение
#      ключа в апострофах проходило насквозь.
#   2. Набор символов был только латинским, и значение с кириллицей
#      оказывалось «коротким» — проверка снова молчала.
#   3. Примеры срабатывания в этих комментариях хук ловил сам у себя,
#      поэтому здесь нет ни одной строки вида имя-равно-значение.
# Теперь значением считается любая непробельная последовательность,
# а шаблоны-заглушки отсеиваются отдельным списком.
set -u

staged="$(git diff --cached --name-only)"
[ -n "$staged" ] || exit 0

fail() {
    echo "ОТКАЗ: $1" >&2
    echo "Ложное срабатывание? git commit --no-verify" >&2
    exit 1
}

# --- файлы, которым в репозитории не место ------------------------------
if printf '%s\n' "$staged" | grep -qE '(^|/)\.env($|\.)'; then
    printf '%s\n' "$staged" | grep -qE '(^|/)\.env\.example$' \
        || fail "в коммите файл .env — секреты в git не идут."
fi

printf '%s\n' "$staged" | grep -qE '\.(pem|key|p12|pfx)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)$' \
    && fail "в коммите приватный ключ."

# --- токены доступа: узнаются по виду, исключений нет -------------------
if git diff --cached -U0 -- . | grep -qE \
   '^\+.*(github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|sk-[A-Za-z0-9]{32,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'; then
    fail "в коммите строка, похожая на токен доступа или приватный ключ."
fi

# --- присвоение секрета длинным значением -------------------------------
# Заглушки и ссылки на переменные окружения — не секреты.
SUSPECT="$(git diff --cached -U0 -- . ':(exclude).env.example' \
    | grep -E '^\+.*(SECRET_KEY|PASSWORD|PASSWD|API_KEY|APIKEY|TOKEN|PRIVATE_KEY|ACCESS_KEY)[[:space:]]*[=:][[:space:]]*["'"'"']?[^[:space:]"'"'"']{12,}' \
    | grep -viE 'os\.environ|getenv|env\(|config\(|process\.env|\$\{|\$\(|<[^>]+>|change[-_ ]?me|replace[-_ ]?me|your[-_ ]|example|placeholder|заглушка|замените|измените|xxxx|\*\*\*\*' \
    || true)"

if [ -n "$SUSPECT" ]; then
    echo "ОТКАЗ: в диффе строка, похожая на секрет:" >&2
    printf '%s\n' "$SUSPECT" | head -3 | sed 's/^/  /' >&2
    echo "Ложное срабатывание? git commit --no-verify" >&2
    exit 1
fi

exit 0
