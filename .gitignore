# Секреты. Пароли живут только на сервере, в репозиторий не попадают.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Виртуальное окружение — у каждой машины своё.
.venv/
venv/

# Собирается командой collectstatic, в репозитории не нужно.
staticfiles/

# Загруженные через админку картинки — это данные, а не код.
media/

# Логи.
logs/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Резервные копии, которые делают установщик и патчи.
.backup-*/

# Редакторы и система.
.idea/
.vscode/
*.swp
.DS_Store
